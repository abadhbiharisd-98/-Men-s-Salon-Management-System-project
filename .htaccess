<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Port-stripping & Trailing Slash Fix for Render Reverse Proxy
RewriteCond %{HTTP:X-Forwarded-Proto} =https [NC]
RewriteRule ^ - [E=PROTO:https]
RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
RewriteRule ^ - [E=PROTO:http]

# Strip internal port :10000 from Host header if forwarded
RewriteCond %{HTTP_HOST} ^([^:]+):10000$ [NC]
RewriteRule ^ %{ENV:PROTO}://%1%{REQUEST_URI} [R=301,L]

# Clean directory trailing slash redirect without leaking internal port
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ %{ENV:PROTO}://%{HTTP_HOST}/$1/ [L,R=301]

# CORS headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# If file or directory exists, serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Application front controller routing
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]
</IfModule>
